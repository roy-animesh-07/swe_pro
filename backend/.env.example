PORT=5000
MONGO_URL=mongodb://127.0.0.1:27017/jis
CORS_ORIGIN=*

# First Registrar account - created only when the users collection is empty.
ADMIN_USERNAME=registrar
ADMIN_PASSWORD=registrar123
ADMIN_NAME=Court Registrar

# Charge recorded for each lawyer view of an old case.
VIEW_CHARGE=100

# Court calendar seed (stored in the court_calendar collection on first start).
# Working days use 0=Sunday ... 6=Saturday. Holidays are YYYY-MM-DD dates.
COURT_WORKING_DAYS=1,2,3,4,5
COURT_TIME_SLOTS=10:00-11:00,11:00-12:00,12:00-13:00,14:00-15:00,15:00-16:00
COURT_HOLIDAYS=
COURT_TIMEZONE=Asia/Kolkata

SESSION_TTL_HOURS=12

# Set to the built frontend folder to serve the UI from the API process.
# SERVE_FRONTEND_DIR=../frontend/dist
